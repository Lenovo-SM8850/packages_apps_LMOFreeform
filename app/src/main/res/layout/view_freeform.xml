<?xml version="1.0" encoding="utf-8"?>
<androidx.cardview.widget.CardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    app:cardCornerRadius="16dp"
    app:cardBackgroundColor="@color/color_surface">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content">

        <androidx.constraintlayout.widget.ConstraintLayout
            android:id="@+id/topBarView"
            android:tag="topBarView"
            android:layout_width="0dp"
            android:layout_height="@dimen/top_bar_height"
            android:background="@drawable/color_background"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent">
            <ImageView
                android:id="@+id/appIcon"
                android:layout_width="24dp"
                android:layout_height="16dp"
                android:layout_marginStart="6dp"
                android:tag="appIcon"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent"
                app:layout_constraintBottom_toBottomOf="parent" />
            <TextView
                android:id="@+id/packageName"
                android:tag="packageName"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="2dp"
                android:layout_marginEnd="6dp"
                android:ellipsize="end"
                android:maxLines="1"
                android:textSize="11sp"
                android:textColor="@color/color_text"
                app:layout_constraintStart_toEndOf="@id/appIcon"
                app:layout_constraintEnd_toStartOf="@id/arrowBack"
                app:layout_constraintTop_toTopOf="parent"
                app:layout_constraintBottom_toBottomOf="parent" />
            <ImageView
                android:id="@+id/arrowBack"
                android:layout_width="24dp"
                android:layout_height="16dp"
                android:layout_marginEnd="6dp"
                android:src="@drawable/ic_arrow_back"
                android:tag="arrowBack"
                app:layout_constraintEnd_toStartOf="@id/pinView"
                app:layout_constraintTop_toTopOf="parent"
                app:layout_constraintBottom_toBottomOf="parent" />
            <ImageView
                android:id="@+id/pinView"
                android:layout_width="24dp"
                android:layout_height="16dp"
                android:layout_marginEnd="6dp"
                android:tag="pinView"
                android:src="@drawable/ic_pin"
                app:layout_constraintEnd_toStartOf="@id/maximizeView"
                app:layout_constraintTop_toTopOf="parent"
                app:layout_constraintBottom_toBottomOf="parent" />
            <ImageView
                android:id="@+id/maximizeView"
                android:layout_width="24dp"
                android:layout_height="16dp"
                android:layout_marginEnd="6dp"
                android:tag="maximizeView"
                android:src="@drawable/ic_maximize"
                app:layout_constraintEnd_toStartOf="@id/minimizeView"
                app:layout_constraintTop_toTopOf="parent"
                app:layout_constraintBottom_toBottomOf="parent" />
            <ImageView
                android:id="@+id/minimizeView"
                android:layout_width="24dp"
                android:layout_height="16dp"
                android:layout_marginEnd="6dp"
                android:tag="minimizeView"
                android:src="@drawable/ic_minimize"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintTop_toTopOf="parent"
                app:layout_constraintBottom_toBottomOf="parent" />
        </androidx.constraintlayout.widget.ConstraintLayout>

        <FrameLayout
            android:id="@+id/freeform_root"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:tag="freeform_root"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/topBarView" />

        <FrameLayout
            android:id="@+id/veilView"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:tag="veilView"
            android:visibility="gone"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/topBarView">

            <ImageView
                android:id="@+id/veilAppIcon"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:layout_gravity="center"
                android:tag="veilAppIcon" />
        </FrameLayout>

        <LinearLayout
            android:id="@+id/minimized_icon_container"
            android:tag="minimizedIconContainer"
            android:layout_width="@dimen/minimized_container_width"
            android:layout_height="@dimen/minimized_container_height"
            android:visibility="gone"
            android:background="@drawable/minimized_icon_bg"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:paddingStart="4dp"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent">

            <ImageView
                android:layout_width="12dp"
                android:layout_height="24dp"
                android:src="@drawable/chevron_left"
                android:tint="@color/color_minimized_foreground" />

            <ImageView
                android:id="@+id/minimized_icon_image"
                android:tag="minimizedIconImage"
                android:layout_width="@dimen/minimized_icon_size"
                android:layout_height="@dimen/minimized_icon_size"
                android:layout_weight="1"
                android:padding="4dp"
                android:scaleType="centerInside" />
        </LinearLayout>

        <ImageView
            android:id="@+id/bubbleView"
            android:tag="bubbleView"
            android:layout_width="72dp"
            android:layout_height="72dp"
            android:visibility="gone"
            android:elevation="6dp"
            android:scaleType="centerCrop"
            android:background="@drawable/bubble_bg"
            android:padding="12dp"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintBottom_toBottomOf="parent" />

        <View
            android:id="@+id/leftScale"
            android:layout_width="@dimen/resize_handle_size"
            android:layout_height="@dimen/resize_handle_size"
            android:tag="leftScaleView"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toStartOf="parent" />

        <View
            android:id="@+id/rightScale"
            android:layout_width="@dimen/resize_handle_size"
            android:layout_height="@dimen/resize_handle_size"
            android:tag="rightScaleView"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent" />
    </androidx.constraintlayout.widget.ConstraintLayout>

</androidx.cardview.widget.CardView>
